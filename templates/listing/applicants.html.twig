<h1>Applicants for {{ listing.title }}</h1>

{% for application in applications %}

<div>

<p><strong>Applicant:</strong>{{ application.user.email }}</p>
<p><strong>Status:</strong>{{ application.status }}</p>
<p><strong>Applied:</strong>{{ application.createdAt|date('Y-m-d')}}</p>
<p><strong>Cover Message</strong></p>
<p>{{ application.coverMessage}}</p>

<a href="{{ path('app_application_accept', {id: application.id}) }}">Accept</a>
<a href="{{ path('app_application_reject', {id: application.id}) }}">Reject</a>

</div>

{% else %}
<p>No applications</p>
{% endfor %}