<h1>Applicants for {{ listing.title }}</h1>

{% for application in applications %}

<div>

<p><strong>Applicant:</strong>{{ application.freelancer.user.email }}</p>
<p><strong>Status:</strong>{{ application.status }}</p>
<p><strong>Applied:</strong>{{ application.createdAt|date('Y-m-d')}}</p>

<li>
    <a href="{{ path('app_application_show', {id: application.id}) }}">
        {{ application.freelancer.user.name }}
    </a>
     — {{ application.status }}
</li>
</div>

{% else %}
<p>No applications</p>
{% endfor %}