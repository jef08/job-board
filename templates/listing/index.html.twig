{% extends 'base.html.twig' %}
{% block title %}All listings{% endblock %}

{% block body_class %}textured-bg{% endblock %}
{% block body %}
<div class="container p-5" style="min-height: calc(100vh - 76px);">
    <div class="mb-5">
        <h1 class="mb-0">Welcome!</h1>
        <p>Check out our latest listings or search by category</p>
    </div>

<form method="get">
    <input
        type="text"
        name="search"
        placeholder="Search listings..."
        value="{{ app.request.query.get('search') }}" >

    <select name="category">
        <option value="">All Categories</option>
        {% for category in categories %}
            <option
                value="{{ category.id }}"
                {% if app.request.query.get('category') == category.id %}
                    selected
                {% endif %}
            >
                {{ category.name }}
            </option>
        {% endfor %}
    </select>
    <button type="submit">
        Search
    </button>
</form>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
{% for listing in listings %}
<div class="col">
<div class="card shadow-sm">
    <div class="card-body">
        <h5 class="card-title">{{ listing.title }}</h5>
        <p class="card-subtitle mb-2">{{ listing.company.user.name }}</p>
        <p class="card-text small">{{ listing.description|truncate_words(20) }}</p>
        <p class="card-text small">{{ listing.jobType }} &middot; {{ listing.salaryRange }}</p>
        <a href="{{ path('app_listing_show', {slug: listing.slug}) }}" class="btn tertiary-button btn-sm">View Listing</a>
    </div>
</div>
</div>
{% else %}
    <p>No listings found.</p>
{% endfor %}
</div>
</div>
{% endblock %}
