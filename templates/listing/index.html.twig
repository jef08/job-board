{% extends 'base.html.twig' %}

{% block title %}Hello ListingController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<h1>Job Listings</h1>
<form method="get">

    <input
        type="text"
        name="search"
        placeholder="Search listings..."
        value="{{ app.request.query.get('search') }}" >

    <select name="category">
        <option value="">All Categories</option>

        {% for category in categories %}
            <option
                value="{{ category.id }}"
                {% if app.request.query.get('category') == category.id %}
                    selected
                {% endif %}
            >
                {{ category.name }}
            </option>
        {% endfor %}
    </select>

    <button type="submit">
        Search
    </button>


</form>
{% for listing in listings %}
 <div>
    <h2>{{ listing.title }}</h2>
    <p>{{ listing.description }}</p>
    <p><strong>Category:</strong>{{ listing.category.name }}</p>
    <p><strong>Posted by:</strong>{{ listing.company.user.email }}</p>
    <p><strong>Status:</strong>{{ listing.status }}</p>
    <a href="{{ path('app_listing_show', {id: listing.id}) }}">View Details</a>
 </div>
{% else %}
    <p>No listings found.</p>
{% endfor %}
{% endblock %}
