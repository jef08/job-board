{% extends 'base.html.twig' %}

{% block title %}Freelancer Dashboard{% endblock %}

{% block body %}
    <h1>Welcome back, {{ app.user.name }}</h1>
    <a href="{{ path('app_freelancer_profile_edit') }}">Edit Profile</a>

    <h2>Featured Listings</h2>
    <ul>
        {% for listing in featuredListings %}
            <li>
                <a href="{{ path('app_listing_show', {slug: listing.slug}) }}">{{ listing.title }}</a>
                — {{ listing.company.user.name }}
            </li>
        {% else %}
            <li>No open listings right now.</li>
        {% endfor %}
    </ul>
    <a href="{{ path('app_listing') }}">Browse all listings</a>

    <h2>Your Recent Applications</h2>
    <ul>
        {% for application in recentApplications %}
            <li>
                <a href="{{ path('app_application_show', {id: application.id}) }}">
                    {{ application.listing.title }}
                </a>
                — {{ application.status.label }}
            </li>
        {% else %}
            <li>You haven't applied to anything yet.</li>
        {% endfor %}
    </ul>
    <a href="{{ path('app_freelancer_applications') }}">View all your applications</a>

    {% if app.user %}
    <a href="{{ path('app_logout') }}">Log out</a>
{% endif %}
{% endblock %}
