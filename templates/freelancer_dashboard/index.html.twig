{% extends 'base.html.twig' %}

{% block title %}Freelancer Dashboard{% endblock %}
{% block body_class %}textured-bg{% endblock %}
{% block body %}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1 class="mb-0">Welcome back, {{ app.user.name }}</h1>
        <a href="{{ path('app_freelancer_profile_edit') }}" class="btn edit-button">Edit Profile</a>
    </div>

    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="mb-0">Featured Listings</h2>
            <a href="{{ path('app_listing') }}" style="color: var(--text-on-accent);">Browse all listings</a>
        </div>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            {% for listing in featuredListings %}
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">{{ listing.title }}</h5>
                            <p class="card-subtitle mb-2">{{ listing.company.user.name }}</p>
                            <p class="card-text small">{{ listing.description|truncate_words(20) }}</p>
                            <p class="card-text small">{{ listing.jobType }} &middot; {{ listing.salaryRange }}</p>
                            <a href="{{ path('app_listing_show', {slug: listing.slug}) }}" class="btn tertiary-button btn-sm">View Listing</a>
                        </div>
                    </div>
                </div>
            {% else %}
                <p class="text-secondary">No open listings right now.</p>
            {% endfor %}
        </div>
    </section>

    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="mb-0">Your Recent Applications</h2>
            <a href="{{ path('app_freelancer_applications') }}" style="color: var(--text-on-accent);">View all your applications</a>
        </div>
        <div class="list-group">
            {% for application in recentApplications %}
                <a href="{{ path('app_application_show', {id: application.id}) }}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                    <div>
                        <strong>{{ application.listing.title }}</strong>
                        <div class="text-secondary small">{{ application.listing.company.user.name }}</div>
                    </div>
                    <span class="badge {{ application.status.value == 'rejected' ? 'bg-danger text-light' : (application.status.value == 'accepted' ? 'bg-success' : 'bg-secondary') }}">
                    {{ application.status.label }}
                </span>
                </a>
            {% else %}
                <p class="text-secondary">You haven't applied to anything yet.</p>
            {% endfor %}
        </div>
    </section>

    <section class="mb-5">
        <h2 class="mb-3">Companies Hiring Now</h2>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            {% for company in featuredCompanies %}
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">{{ company.user.name }}</h5>
                            {% if company.industry %}
                                <p class="card-subtitle mb-2">{{ company.industry }}</p>
                            {% endif %}
                            <a href="{{ path('app_company_show', {id: company.id}) }}" class="btn tertiary-button btn-sm">View Profile</a>
                        </div>
                    </div>
                </div>
            {% else %}
                <p class="text-secondary">No companies actively hiring right now.</p>
            {% endfor %}
        </div>
    </section>
</div>
{% endblock %}
