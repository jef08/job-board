{% extends 'base.html.twig' %}

{% block title %}Edit Profile{% endblock %}

{% block body %}
    <h1>Edit Your Profile</h1>

    {{ form_start(form) }}
        {{ form_row(form.name) }}
        {{ form_row(form.location) }}
        {{ form_row(form.bio) }}
        {{ form_row(form.freelancer.category) }}
        {{ form_row(form.freelancer.hourlyRate) }}
        {{ form_row(form.freelancer.yearsExperience) }}
        <button type="submit">Save Changes</button>
    {{ form_end(form) }}
{% endblock %}