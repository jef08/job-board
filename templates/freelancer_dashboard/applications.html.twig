{% extends 'base.html.twig' %}
{% block title %}Applications{% endblock %}
{% block body_class %}textured-bg{% endblock %}

{% block body %}

<div class="container p-5" style="min-height: calc(100vh - 76px);">
    <div class="mb-5">
        <h1>See your Applications</h1>
        <a href="{{ path('freelancer_dashboard') }}" style="text-decoration: none; width: 125px;" class="btn edit-button mt-4 text-center">&larr; Return</a>
    </div>

{% for application in applications %}
<div class="col my-2">
    <div class="card h-100 shadow-sm">
        <div class="card-body d-flex flex-column">
            <h2>{{ application.listing.title }}</h2>
            <p><strong>Company: </strong>{{ application.listing.company.user.email }}</p>

            <p><strong>Status: </strong>{{ application.status.label }}</p>

            <p><strong>Applied on: </strong>{{ application.createdAt|date('Y-m-d') }}</p>

            <a href="{{ path('app_listing_show', {slug: application.listing.slug}) }}" style="color: var(--text-on-accent);">View Listing</a>
        </div>
    </div>
</div>

{% else %}
<p>No applications</p>
{% endfor %}
</div>
{% endblock %}