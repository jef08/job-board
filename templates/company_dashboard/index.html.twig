{% extends 'base.html.twig' %}

{% block title %}Your Listings{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<h1>Company Dashboard</h1>
<a href="{{ path('app_company_profile_edit') }}">Edit Profile</a>
{% for listing in listings %}
<div> 
    <h2>{{ listing.title }}</h2>
    <p><strong>Status: </strong>{{ listing.status.label }}</p>

    <p><strong>Created: </strong>{{ listing.createdAt|date('Y-m-d') }}</p>

    <p><strong>Applications: </strong>{{ listing.applications|length }}</p>

    <a href="{{ path('app_listing_show', {id: listing.id}) }}">View Listing</a>
    <a href="{{ path('app_listing_edit', {id: listing.id}) }}">Edit Listing</a>

    <form method="post" action="{{ path('app_listing_delete', {id: listing.id}) }}" onsubmit="return confirm('Delete this listing? This cannot be undone.');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete-listing-' ~ listing.id) }}">
        <button type="submit">Delete listing</button>
    </form>
    
    <a href="{{ path('app_listing_applicants', {id: listing.id}) }}">View Applicants</a>
    
    <form method="post" action="{{ path('app_listing_close', {id: listing.id}) }}" onsubmit="return confirm('Close this listing?');">
        <input type="hidden" name="_token" value="{{ csrf_token('close-listing-' ~ listing.id) }}">
        <button type="submit">Close listing</button>
    </form>

</div>

{% else %}
<p>You haven't created any listings yet.</p>
{% endfor %}

{% endblock %}
