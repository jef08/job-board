{% extends 'base.html.twig' %}

{% block title %}{{ freelancer.user.name }}{% endblock %}
{% block body_class %}textured-bg{% endblock %}
{% block body %}
<div class="container p-5" style="min-height: calc(100vh - 76px);">
<div class="col">
    <div class="card px-3 px-lg-5 h-100 shadow-sm">
        <div class="card-body d-flex flex-column">
            <h1 class="card-title text-center">{{ freelancer.user.name }}</h1>
            
            <p class="text-secondary mb-2 text-center">
                <i class="bi {{ freelancer.category.icon }} category-icon" aria-hidden="true"></i>
                {{ freelancer.category.name }}
            </p>

            {% if freelancer.user.bio %}
                <p class="text-center pb-3">{{ freelancer.user.bio }}</p>
            {% endif %}

            {% if freelancer.user.location %}
                <p><strong>Location:</strong> {{ freelancer.user.location }}</p>
            {% endif %}

            {% if freelancer.hourlyRate %}
                <p><strong>Rate:</strong> €{{ freelancer.hourlyRate }}/hr</p>
            {% endif %}

            {% if freelancer.yearsExperience %}
                <p><strong>Experience:</strong> {{ freelancer.yearsExperience }} years</p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}