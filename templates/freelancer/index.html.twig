{% extends 'base.html.twig' %}

{% block title %}Freelancers{% endblock %}
{% block body_class %}textured-bg{% endblock %}
{% block body %}
<div class="container p-5" style="min-height: calc(100vh - 76px);">
    <h1>Freelancers</h1>

    <form method="get" class="row g-2 mb-4">
        <div class="col-md-10">
            <select name="category" class="form-select">
                <option value="">All Categories</option>
                {% for category in categories %}
                    <option value="{{ category.id }}" {% if app.request.query.get('category') == category.id %}selected{% endif %}>
                        {{ category.name }}
                    </option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn primary-button w-100">Filter</button>
        </div>
    </form>

    <div class="freelancer-list">
        {% for freelancer in freelancers %}
            <div class="col my-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h2>
                            <a href="{{ path('app_freelancer_show', {id: freelancer.id}) }}" style="color: var(--text-on-accent);">
                                {{ freelancer.user.name }}
                            </a>
                        </h2>
                        {% if freelancer.category %}
                            <p class="text-secondary mb-2">
                                <i class="bi {{ freelancer.category.icon }} category-icon" aria-hidden="true"></i>
                                {{ freelancer.category.name }}
                            </p>
                        {% endif %}
                        {% if freelancer.user.location %}
                            <p>{{ freelancer.user.location }}</p>
                        {% endif %}
                        {% if freelancer.hourlyRate %}
                            <p>€{{ freelancer.hourlyRate }}/hr</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% else %}
            <p>No freelancers registered yet.</p>
        {% endfor %}
    </div>
{% endblock %}